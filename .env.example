# Local mode binds to 127.0.0.1. Keep actual secrets out of this file.
BENION_PORT=5197
# BENION_DATA_DIR=/absolute/private/path/benion

# Configure these privately on your host.
# BENION_MODE=production
# PORT=80
# BENION_PUBLIC_ORIGIN=https://your-benion.example.com
# BENION_ADMIN_PASSWORD=<random password, at least 20 characters>
# BENION_SESSION_SECRET=<distinct random secret, at least 32 characters>
# BENION_META_APP_SECRET=<Instagram app secret>
# BENION_META_VERIFY_TOKEN=<random webhook verification token>
# BENION_OPERATOR_NAME=<your operator name>
# BENION_PRIVACY_EMAIL=<your contact email>
# BENION_CONVERSION_SECRET=<distinct backend-only secret, at least 32 characters>
# BENION_MCP_TOKEN=<distinct random base64url secret, at least 43 characters>
# Optional credential references for MCP onboarding; agents pass only the suffix PRIMARY.
# BENION_MCP_INSTAGRAM_TOKEN_PRIMARY=<private Instagram token>
# BENION_MCP_OPENROUTER_KEY_PRIMARY=<private OpenRouter key>

# Optional AI. The dashboard can save a private OpenRouter key.
# Select a supported structured-output model for your provider.
# BENION_LLM_PROVIDER=openrouter
# BENION_LLM_MODEL=<provider model ID>
# OPENROUTER_API_KEY=<private key>
# Live assistant activation currently requires a key verified through the OpenRouter dashboard form.
